generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MaintenanceNote {
  @@map("maintenance_notes")
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priority    NotePriority    @default(AVERAGE)
  title       String          
  description String         
  created_at  DateTime        @default(now()) @db.Timestampz(6)
  note_status NoteStatus      @default(OPEN)
  profile     Profile         @relation(fields: [profile_id], references: [id])
  profile_id  String          @db.Uuid          
}

model User {
  @@map("users")
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique 
  password      String    
  profile       Profile?
  role          Role      @default(OPERATOR)
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestampz(6)
}

model Profile {
  @@map("profiles")
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user              User                @relation(fields: [user_id], references: [id])
  user_id           String              @unique @db.Uuid
  name              String              
  maintenance_notes MaintenanceNote[]
}

enum Role {
  ADMIN
  GATEKEEPER
  PLANNER
  PROGRAMMER
  OPERATOR
}

enum NotePriority {
  LOW
  AVERAGE
  HIGH
  URGENT
}

enum NoteStatus {
  OPEN
  PLANNING
  PROGRAMMING
  EXECUTING
  DONE
  CLOSED
}
